# Copy to .env, chmod 600 .env. Values below are fictitious: CHANGE THEM.
COMPOSE_PROJECT_NAME=adoptalia
MYSQL_DATABASE=adoptalia_db
MYSQL_USER=adoptalia_user
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_random_password
MYSQL_PASSWORD=CHANGE_ME_app_random_password
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=80
# phpMyAdmin is localhost-only by default. Use a trusted LAN address if needed.
PMA_BIND_ADDRESS=127.0.0.1
PMA_PORT=8080
DB_DATA_DIR=./db/mysql
UPLOADS_DATA_DIR=./data/uploads
APP_IMAGE_PREFIX=adoptalia
APP_VERSION=local
# Empty: same-origin only (recommended behind Nginx).
CORS_ORIGINS=
# Express trusts Nginx/private network hops, not arbitrary client headers.
TRUST_PROXY=loopback,linklocal,uniquelocal
# Optional image overrides: use an explicit version and digest, never latest.
# MYSQL_IMAGE=mysql:8.0.45@sha256:...
# PHPMYADMIN_IMAGE=phpmyadmin/phpmyadmin:5.2.3@sha256:...
